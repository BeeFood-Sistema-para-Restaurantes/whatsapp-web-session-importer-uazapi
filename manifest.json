{
  "manifest_version": 3,
  "name": "BeeFood — Conectar WhatsApp",
  "version": "0.3.0",
  "description": "Conecta a sessão do WhatsApp Web à sua conta BeeFood, com aprovação do usuário.",
  "action": {
    "default_title": "BeeFood — Conectar WhatsApp",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.uazapi.com/*",
    "https://*.beefood.com.br/*",
    "https://*.lovable.app/*",
    "https://*.lovableproject.com/*",
    "https://*.lovable.dev/*",
    "http://localhost/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.beefood.com.br/*",
      "https://*.lovable.app/*",
      "https://*.lovableproject.com/*",
      "https://*.lovable.dev/*",
      "http://localhost/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["autofill.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.uazapi.com/*",
        "https://*.beefood.com.br/*",
        "https://*.lovable.app/*",
        "https://*.lovableproject.com/*",
        "https://*.lovable.dev/*",
        "http://localhost/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
